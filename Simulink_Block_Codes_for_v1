% --- OD Sensor Model Code ---

function OD_measured = ODSensorModel(X)
% X : true biomass concentration
% Output:
% OD_measured : simulated OD sensor reading with noise

    k = 1.0;           % scaling factor between true biomass and OD
    noise_level = 0.02; % ±2% noise

    % Generate Gaussian noise
    noise = noise_level * randn;

    % Simulated measured OD
    OD_measured = k * X + noise;
end
-----------------------------------------------------------------------------------------------------
% --- Controller Code ---
function D = Controller(X_measured)
persistent error_int
if isempty(error_int)
    error_int = 0;
end

% --- Controller parameters ---
OD_setpoint = 0.4;     % desired OD / biomass level
Kp = 0.25;             % proportional gain
Ki = 0.02;             % integral gain
dt = 0.1;              % same as simulation step time

% --- Compute control error ---
error = OD_setpoint - X_measured;

% --- Integrate error ---
error_int = error_int + error * dt;

% --- Compute control output (with correct sign for turbidostat) ---
D = 0.05 - (Kp * error + Ki * error_int);
%  ↑  note the minus sign (reduces D when OD < setpoint)

% --- Apply physical limits ---
D = max(min(D, 0.6), 0.01);   % between 0.01–0.5 1/h typical for algal dilution
end
---------------------------------------------------------------------------------------------------------------
% --- Bioreactor code ---
function X_next = BioprocessModel(X, D, mu, dt)
% TuRAC Turbidostat Bioprocess Model
% Inputs:
%   X  - Current biomass concentration (OD proxy)
%   D  - Dilution rate [1/h]
%   mu - Specific growth rate [1/h]
%   dt - Simulation time step [h]
%
% Output:
%   X_next - Updated biomass concentration after one step

    % --- Growth model ---
    % dX/dt = mu*X - D*X
    dXdt = mu * X - D * X;

    % --- Euler integration (discrete update) ---
    X_next = X + dXdt * dt;

    % --- Prevent negative OD values ---
    if X_next < 0
        X_next = 0;
    end

    % --- Optional: Add small process noise to mimic biological variation
   % noise_level = 0.005;  % ±0.5% noise on OD
    %X_next = X_next + noise_level * randn;

end
---------------------------------------------------------------------------------------------------------------
% ---pump code ---

function D_out = Pump_Actuator(D_in)
    %#codegen
coder.extrinsic('fprintf')  % optional
X_next = double(0);
    delay_factor = 0.9; % simulate response lag
    D_out = delay_factor * D_in;
end
